widget "codex usage" {
  meta { owl: 10; description: "Shows live Codex account limits and reset times"; version: "1.0.2"; license: "MIT"; category: "dev" }
  size: 3x2
  minSize: 3x2

  requires { pacman: ["bash", "jq", "coreutils"] }

  state refreshRequest = 0
  state limits = null
  onTap: refreshRequest = refreshRequest + 1

  asset chatgptLogo = base64""

  // Query the signed-in account through the installed Codex CLI.
  source check = cmd("""
    read_limits() {
      local codex_bin response=null
      codex_bin=$(type -P codex)
      if [[ ! -x "$codex_bin" ]]; then
        codex_bin="$HOME/.local/share/mise/installs/codex/latest/bin/codex"
      fi
      if [[ -x "$codex_bin" ]]; then
        response=$(timeout -k 1s 12s bash -c '
          coproc rpc { exec "$1" app-server 2>/dev/null; }
          pid=$rpc_PID
          trap "kill $pid 2>/dev/null; wait $pid 2>/dev/null" EXIT
          exec {rpc_in}>&"${rpc[1]}" {rpc_out}<&"${rpc[0]}" || exit 1

          printf "%s\n" "{\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"codex_usage_widget\",\"version\":\"1.0.2\"}}}" >&"$rpc_in" || exit 1
          while IFS= read -r -u "$rpc_out" reply; do
            initialized=$(jq -r "select(.id == 1) | .result != null" <<< "$reply")
            [[ -n "$initialized" ]] && break
          done
          [[ "$initialized" == true ]] || exit 1

          printf "%s\n" "{\"method\":\"initialized\"}" "{\"id\":2,\"method\":\"account/rateLimits/read\"}" >&"$rpc_in" || exit 1
          while IFS= read -r -u "$rpc_out" reply; do
            if jq -ec "select(.id == 2)" <<< "$reply"; then exit 0; fi
          done
          exit 1
        ' _ "$codex_bin" 2>/dev/null) || response=null
      fi

      jq -nc --argjson request "$1" --argjson checkedAt "$(date +%s)" --argjson response "$response" '
        ($response.result.rateLimitsByLimitId.codex // $response.result.rateLimits) as $limits
        | {request: $request, checkedAt: $checkedAt, primary: $limits.primary, secondary: $limits.secondary}
        | .ok = ((.primary.usedPercent | type == "number") or (.secondary.usedPercent | type == "number"))
      '
    }
  """ + "\nread_limits ${int(refreshRequest)}") every 1m json timeout 18s

  on check first {
    if value.request == refreshRequest && value.ok { limits = value }
  }

  let refreshing = check == null || check.request != refreshRequest
  let refreshFailed = !refreshing && !check.ok
  let updatedAt = fmtTime(limits.checkedAt, "HH:mm:ss")
  let refreshStatus = refreshing ? "↻ Refreshing…" : refreshFailed ? "Refresh failed" : "Updated ${updatedAt}"
  let fiveUsed = limits.primary.usedPercent
  let weekUsed = limits.secondary.usedPercent
  let compact = cols == null || cols < 3 || rows == null || rows < 3
  let fiveReset = fmtTime(limits.primary.resetsAt, compact ? "HH:mm" : "EEE, MMM d · HH:mm")
  // A narrow tile (landscape) can't fit the date: the weekday is enough within a week.
  let narrow = tileWidth != null && tileWidth < 170
  let weekReset = fmtTime(limits.secondary.resetsAt, !compact ? "EEE, MMM d · HH:mm" : narrow ? "EEE HH:mm" : "MMM d HH:mm")

  component LimitDetails(used, reset, compact = false) {
    Column {
      gap: compact ? 1 : 2
      Progress {
        value: used == null ? 0 : 100 - used
        color: accent
        track: alpha(muted, 0.22)
        height: compact ? 4 : 7
        fill: width
        animate value: spring()
      }
      if reset != null || used == 0 {
        Text {
          text: reset == null ? "full" : "resets ${reset}"
          style: small
          color: foreground
          maxLines: 1
        }
      }
    }
  }

  component Limit(label, used, reset, mark = false) {
    Column {
      gap: 2
      Row {
        gap: 4
        align: center
        if mark {
          Image { src: chatgptLogo; width: 16; height: 16; tint: accent }
        }
        Text { text: label; fontSize: 18; font: mono; color: foreground; width: 100; bold: true }
        Text { text: used == null ? "—" : "${round(100 - used)}%"; style: body; color: foreground; align: end; weight: 1 }
      }
      LimitDetails { used: used; reset: reset }
    }
  }

  component CompactLimit(label, used, reset, mark = false) {
    Column {
      gap: 1
      Row {
        gap: 4
        align: center
        if mark {
          Image { src: chatgptLogo; width: 14; height: 14; tint: accent }
        }
        Text { text: used == null ? "${label} —" : "${label} ${round(100 - used)}%"; fontSize: 15; font: mono; color: foreground; bold: true; weight: 1; maxLines: 1 }
      }
      LimitDetails { used: used; reset: reset; compact: true }
    }
  }

  Column {
    gap: compact ? 5 : 10
    if compact {
      CompactLimit { label: "5h"; used: fiveUsed; reset: fiveReset; mark: true }
      CompactLimit { label: "1week"; used: weekUsed; reset: weekReset }
    } else {
      Limit { label: "5h"; used: fiveUsed; reset: fiveReset; mark: true }
      Limit { label: "1week"; used: weekUsed; reset: weekReset }
    }
    Text {
      text: refreshStatus
      style: small
      color: refreshing ? accent : refreshFailed ? red : muted
      maxLines: 1
    }
  }
}
